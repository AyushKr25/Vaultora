# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=your-super-secret-key-change-in-production

# JWT Configuration
JWT_SECRET_KEY=jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# Database Configuration (Supabase PostgreSQL)
# Option 1: single connection URL (postgresql://user:password@host:port/db)
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres
# Option 2: individual parts
DB_HOST=aws-0-YOUR-REGION.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.YOUR_PROJECT_REF
DB_PASSWORD=your-database-password

# Rate Limiting
RATELIMIT_DEFAULT=100/hour
RATELIMIT_STORAGE_URL=memory://

# CORS (add your deployed frontend URL, comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# File Upload
MAX_CONTENT_LENGTH=16777216
